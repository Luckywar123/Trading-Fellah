+def _issued_at_from_expiry(expires_at: datetime) -> str:
+    """Issued At diturunkan dari expires_at (yang disimpan di DB), jadi pesan
+    yang dibangun ulang pas verify PERSIS sama dengan yang ditandatangani user.
+    Sebelumnya pakai datetime.now() tiap kali -> pesan beda -> signature selalu gagal."""
+    issued = (expires_at - timedelta(seconds=NONCE_TTL_SECONDS)).astimezone(timezone.utc)
+    return issued.replace(microsecond=0).isoformat()
+
+
+def _parse_ts(value: str) -> datetime:
+    dt = datetime.fromisoformat(value.replace("Z", "+00:00"))
+    if dt.tzinfo is None:
+        dt = dt.replace(tzinfo=timezone.utc)
+    return dt
+
+
