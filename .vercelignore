# Semua pattern di-anchor ke ROOT repo (pakai leading "/") biar gak
# ketimpa ke folder senama di dalam frontend/ (misal frontend/src/).

# Backend (deploy terpisah ke Railway/Render, bukan Vercel)
/backend/

# Kode trading-bot lama di root (bukan bagian dari web app)
/src/
/config/
/database.py
/requirements.txt
/scripts/
/supabase/

# Folder legacy/duplikat, gak kepake app yang sekarang
/web/

# Virtualenv Python — harusnya udah di .gitignore, tapi kalau kepush
# jangan sampai ikut ke-scan Vercel
/.venv/
/venv/

# Docs & compose file, gak perlu ikut deploy
/DEPLOYMENT.md
/docker-compose.yml
