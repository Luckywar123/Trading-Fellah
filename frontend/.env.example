# Copy jadi ".env" di folder frontend/ (lokal).
# Di Vercel: Settings -> Environment Variables -> VITE_API_URL = URL backend kamu
# (contoh: https://trading-fellah-api.onrender.com) TANPA slash di belakang.
# PENTING: variabel VITE_* di-bake saat BUILD, jadi setelah ganti harus Redeploy.
VITE_API_URL=http://localhost:8000
