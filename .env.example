# Copy file ini jadi ".env" di ROOT project (folder yang sama isi backend/ & frontend/)
# lalu isi semua value di bawah. JANGAN commit .env yang udah keisi ke git.

# ============================================================================
# APP
# ============================================================================
ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# ============================================================================
# AUTH — session JWT internal (setelah wallet login sukses)
# generate: python -c "import secrets; print(secrets.token_hex(32))"
# ============================================================================
JWT_SECRET=

# ============================================================================
# ENKRIPSI PASSWORD MT5 — WAJIB diisi, dan WAJIB dibackup di tempat aman.
# generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ============================================================================
CREDENTIAL_ENCRYPTION_KEY=

# ============================================================================
# SUPABASE — buat project gratis di https://supabase.com
# Settings -> API -> copy "Project URL" dan "service_role" key (BUKAN anon key)
# Lalu jalankan isi supabase/schema.sql di SQL Editor project kamu.
# ============================================================================
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================================
# METAAPI — jembatan cloud ke MT5, daftar di https://metaapi.cloud
# Dashboard -> API access -> generate token
# ============================================================================
METAAPI_TOKEN=
METAAPI_REGION=new-york

# ============================================================================
# AI AGENT — pilih salah satu provider (bisa isi dua-duanya buat gampang switch)
# ============================================================================
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# ============================================================================
# NEWS DATA — dipakai buat news sentiment AI. Contoh pakai Finnhub (ada free tier)
# daftar di https://finnhub.io
# ============================================================================
NEWS_PROVIDER=finnhub
NEWS_API_KEY=

# ============================================================================
# PEMBAYARAN CRYPTO — NOWPayments (https://nowpayments.io)
# Daftar akun -> Store Settings -> API Key, dan bikin IPN secret buat webhook
# ============================================================================
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Harga plan membership (USD, ditagih dalam crypto)
PLAN_PRICE_BASIC=29
PLAN_PRICE_PRO=79
PLAN_PRICE_ELITE=199
